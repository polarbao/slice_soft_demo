  "safetyInvariants": {
    "packageSchema": "p0.rgbwsv.2",
    "channelOrder": ["R", "G", "B", "W", "S", "V"],
    "bitDepth": 8,
    "polarity": "black_is_print",
    "previewIsProductionData": false,
    "openvdbDefaultEnabled": false,
    "multiModelProductionDefault": false
