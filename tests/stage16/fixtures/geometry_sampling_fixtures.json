        { "x": 0, "y": 0, "intervalsMm": [[0.0, 0.875]] },
        { "x": 1, "y": 0, "intervalsMm": [[0.0, 0.625]] },
        { "x": 2, "y": 0, "intervalsMm": [[0.0, 0.375]] },
        { "x": 3, "y": 0, "intervalsMm": [[0.0, 0.125]] }
