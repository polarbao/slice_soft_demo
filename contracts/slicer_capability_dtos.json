    "textureRequiredIfPresent": true,
    "noSilentTextureFallback": true,
    "noNewBlobCapability": true,
    "noNewAbiExport": true
  },
  "sceneOperationRules": {
    "applicationOrder": "request_order",
    "atomic": true,
    "implicitSceneCreation": {
      "requires": [
        "sceneHandle_absent",
        "scene_absent_or_empty_object",
        "operations_contains_addInstance",
        "sceneContext_valid",
        "currentSceneRevision_equals_0",
        "expectedSceneRevision_equals_0"
      ],
      "responseRequires": ["sceneHandle"],
      "legacyOperationOnlyRequestWithoutScene": "preserve_previous_failure",
      "nonEmptyInlineScene": "preserve_v1.4_behavior"
    },
    "sceneContext": {
      "requiredOnlyFor": "implicit_scene_create",
      "forbiddenWith": ["sceneHandle", "non_empty_inline_scene"],
      "profileSource": "host_authority",
      "buildVolumeSource": "device_profile",
      "fixtureBuildVolumeAllowed": false,
      "includedInOperationFingerprint": true
    },
    "operationRequirements": {
      "addInstance": {
        "required": ["modelId"],
        "optional": ["assignInstanceId", "initialTransform"],
        "forbidden": ["instanceId"],
        "modelPrecondition": "model.import_succeeded_and_not_released",
        "allocatedInstanceId": "module_unique_when_assignInstanceId_absent",
        "defaultInitialTransform": {
          "translateXMm": 0,
          "translateYMm": 0,
          "rotateXDeg": 0,
          "rotateYDeg": 0,
          "rotateZDeg": 0,
          "uniformScale": 1,
          "mirrorX": false,
          "mirrorY": false,
          "landOnBuildPlate": false
        }
      },
      "removeInstance": {
        "required": ["instanceId"],
        "modelRelease": "not_implied"
      },
      "applyGridLayout": {
        "required": [
          "layout.policy",
          "layout.maxColumns",
          "layout.maxRows",
          "layout.columnGapMm",
          "layout.rowGapMm",
          "layout.spacingMode",
          "layout.order"
        ],
        "forbidden": ["instanceId", "modelId", "assignInstanceId", "initialTransform"],
        "batchMode": "sole_operation",
        "instanceOrder": "scene_order",
        "hiddenInstancesOccupyCells": true,
        "lockedInstancesRemainInPlace": true,
        "capacityLimit": 22,
        "resultIncludesCollisionAndOutOfBounds": true
      },
      "translate": { "required": ["instanceId", "deltaMm"] },
      "rotateX": { "required": ["instanceId", "degrees"] },
      "rotateY": { "required": ["instanceId", "degrees"] },
      "rotateZ": { "required": ["instanceId", "degrees"] },
      "uniformScale": { "required": ["instanceId", "factor"] },
      "mirror": { "required": ["instanceId", "axis"] },
      "landOnBuildPlate": {
        "required": ["instanceId"],
        "targetPlane": "z_equals_zero",
        "persistentForSubsequentTransforms": true
      }
    },
    "sessionLifetime": {
      "scope": "pm_module_t",
      "releasedBy": "pm_destroy",
      "pm_releaseClosesScene": false,
      "explicitPerSceneClose": false
    },
    "backwardCompatibility": {
      "legacyOperationTypes": ["translate", "rotateZ", "uniformScale", "mirror"],
      "addedOperationTypes": ["rotateX", "rotateY", "landOnBuildPlate"],
      "legacyRequestResponseSemantics": "unchanged",
      "newResponseSceneHandleOnlyFor": "implicit_scene_create",
      "standaloneSceneLayoutCapability": "forbidden_use_scene.apply_operation"
    }
  },
  "viewDataRules": {
    "top": {
      "requiredContent": ["surface_preview", "appearance"],
      "outlineOnlyKeepsSurfacePreview": true
    },
    "three_d": {
      "requiredContent": ["mesh", "appearance"],
      "outlineOnlyAllowed": false
    },
    "multiModelAppearance": {
      "collection": "appearances[]",
      "identityField": "appearances[].appearanceIdentity",
      "instanceReference": "instances[].appearanceIdentity",
      "previewReference": "instances[].surfacePreview.appearanceIdentity",
      "materialResolutionScope": "instance_appearance"
    },
    "multiInstanceMesh": {
      "collection": "meshes[]",
      "identityField": "meshes[].meshIdentity",
      "instanceReference": "instances[].meshIdentity",
      "canonicalPlacement": "top_level",
      "legacyCompatibilityAlias": "instances[].mesh",
      "localReuse": "one_mesh_per_model_content_and_lod",
      "worldReuse": "by_mesh_identity_only",
      "blobStorage": "once_per_mesh_identity"
    },
    "meshAttributeEncoding": {
      "requestField": "meshAttributeFormat",
      "supported": ["float32", "float16"],
      "defaultWhenAbsent": "float32",
      "float16Components": ["position", "normal", "texcoord0"],
      "float16Quantizer": "meshopt_quantizeHalf",
      "budgetUsesSerializedWireBytes": true,
      "meshIdentityIncludesEncoding": true
    },
    "truncationReasons": {
      "separator": ";",
      "meshSimplified": [
        "mesh_simplified_lod1_for_max_bytes",
        "mesh_simplified_lod2_for_max_bytes"
      ],
      "meshDecimatedLegacy": [
        "mesh_decimated_lod1_for_max_bytes",
        "mesh_decimated_lod2_for_max_bytes"
      ],
      "currentProviderEmitsMeshDecimated": false,
      "textureResolutionReduced": "texture_resolution_reduced_for_max_bytes",
      "topPreviewResolutionReduced": "top_preview_resolution_reduced_for_max_bytes"
    },
    "texturedInstanceRequires": ["texcoord0", "submeshes", "materials", "textures"],
    "budgetExhaustion": "reduce geometry or image resolution, then PM-SLICER-VIEWDATA-BUDGET; never drop required texture content",
    "failureMode": "declared texture load/decode/UV/material failure returns an error and no successful gray fallback"
  }
