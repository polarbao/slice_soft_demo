{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slicesoft.local/contracts/slicer_engine_conformance_v1.schema.json",
  "title": "SliceSoft engine conformance suite",
  "type": "object",
  "required": ["schema", "version", "statusValues", "overallRule", "frozenInvariants", "themes"],
  "properties": {
    "schema": { "const": "slicesoft.engine_conformance.14d_07.1" },
    "version": { "const": "1.0" },
    "statusValues": { "const": ["pass", "fail", "blocked", "not_run"] },
    "overallRule": { "const": "all_e01_through_e08_pass" },
    "frozenInvariants": {
      "type": "object",
      "required": ["spiVersion", "exportCount", "capabilityCount", "packageSchema", "channels", "bitDepth", "polarity"],
      "additionalProperties": false
    },
    "themes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "title", "fixtureIds", "comparisons", "passRule", "blockedBy"],
        "properties": {
          "id": { "pattern": "^E-0[1-8]$" },
          "title": { "type": "string", "minLength": 1 },
          "fixtureIds": { "type": "array", "items": { "type": "string" } },
          "comparisons": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "passRule": { "type": "string", "minLength": 1 },
          "blockedBy": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
