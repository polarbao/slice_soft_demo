{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slicesoft.local/contracts/slicer_module_info.schema.json",
  "title": "SliceSoft slicer module runtime information",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "spi",
    "runtime",
    "buildConfig",
    "provides",
    "produces",
    "capabilities"
  ],
  "properties": {
    "schema": {
      "const": "slicesoft.module_info.1"
    },
    "id": {
      "const": "slicer"
    },
    "name": {
      "const": "SliceSoft Geometry Slicer"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "spi": {
      "const": 1
    },
    "runtime": {
      "type": "string",
      "enum": [
        "MSVC-x64-MD",
        "MSVC-x64-MDd"
      ]
    },
    "buildConfig": {
      "type": "string",
      "enum": [
        "Release",
        "Debug"
      ]
    },
    "provides": {
      "const": [
        "model.import",
        "model.get_metadata",
        "model.release",
        "scene.apply_operation",
        "scene.get_snapshot",
        "scene.get_viewdata",
        "geometry.preflight",
        "geometry.collision",
        "geometry.repair",
        "slice.rgbwsv",
        "package.verify",
        "package.get_summary",
        "package.get_layer_descriptor",
        "package.render_layer_preview",
        "package.read_report"
      ],
      "uniqueItems": true
    },
    "produces": {
      "const": [
        {
          "contract": "p0.rgbwsv.2",
          "kind": "package"
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "required": [
        "maxConcurrentJobs",
        "cancelLatencyMs",
        "syncCapabilities",
        "workerCapabilities"
      ],
      "properties": {
        "maxConcurrentJobs": {
          "const": 1
        },
        "cancelLatencyMs": {
          "const": 2000
        },
        "syncCapabilities": {
          "const": [
            "model.import",
            "model.get_metadata",
            "model.release",
            "scene.apply_operation",
            "scene.get_snapshot",
            "scene.get_viewdata",
            "geometry.preflight",
            "geometry.collision",
            "package.verify",
            "package.get_summary",
            "package.get_layer_descriptor",
            "package.render_layer_preview",
            "package.read_report"
          ],
          "uniqueItems": true
        },
        "workerCapabilities": {
          "const": [
            "geometry.preflight",
            "geometry.repair",
            "slice.rgbwsv"
          ],
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "buildConfig": {
            "const": "Debug"
          }
        },
        "required": [
          "buildConfig"
        ]
      },
      "then": {
        "properties": {
          "runtime": {
            "const": "MSVC-x64-MDd"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "buildConfig": {
            "const": "Release"
          }
        },
        "required": [
          "buildConfig"
        ]
      },
      "then": {
        "properties": {
          "runtime": {
            "const": "MSVC-x64-MD"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
