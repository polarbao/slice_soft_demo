{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SliceSoft: Configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Build Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--config",
        "Debug"
      ],
      "dependsOn": "SliceSoft: Configure",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "SliceSoft: Run slicer_cli sample",
      "type": "shell",
      "command": "${workspaceFolder}/build/Debug/slicer_cli.exe",
      "args": [
        "--config",
        "samples/configs/slice_config.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Debug",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Run rip_reader_test sample",
      "type": "shell",
      "command": "${workspaceFolder}/build/Debug/rip_reader_test.exe",
      "args": [
        "--package",
        "output/SlicePackage"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Run slicer_cli sample",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Run slicer_cli model 0.3",
      "type": "shell",
      "command": "${workspaceFolder}/build/Debug/slicer_cli.exe",
      "args": [
        "--config",
        "samples/configs/slice_config_model_0_3.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Debug",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Inspect model 0.3",
      "type": "shell",
      "command": "${workspaceFolder}/build/Debug/slicer_cli.exe",
      "args": [
        "--config",
        "samples/configs/slice_config_model_0_3.json",
        "--inspect-model"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Debug",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Preview-only model 0.3",
      "type": "shell",
      "command": "${workspaceFolder}/build/Debug/slicer_cli.exe",
      "args": [
        "--config",
        "samples/configs/slice_config_model_0_3.json",
        "--preview-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Debug",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Run slicer_cli relief varnish",
      "type": "shell",
      "command": "${workspaceFolder}/build/Debug/slicer_cli.exe",
      "args": [
        "--config",
        "samples/configs/slice_config_relief_varnish.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Debug",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Preview-only relief varnish",
      "type": "shell",
      "command": "${workspaceFolder}/build/Debug/slicer_cli.exe",
      "args": [
        "--config",
        "samples/configs/slice_config_relief_varnish.json",
        "--preview-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Debug",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Run rip_reader_test relief varnish",
      "type": "shell",
      "command": "${workspaceFolder}/build/Debug/rip_reader_test.exe",
      "args": [
        "--package",
        "output/SlicePackage_relief_varnish"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Run slicer_cli relief varnish",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Run support unsupported_only",
      "type": "shell",
      "command": "${workspaceFolder}/build/Debug/slicer_cli.exe",
      "args": [
        "--config",
        "samples/configs/support/support_unsupported_only.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Debug",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Run support bottom_plus_unsupported",
      "type": "shell",
      "command": "${workspaceFolder}/build/Debug/slicer_cli.exe",
      "args": [
        "--config",
        "samples/configs/support/support_bottom_plus_unsupported.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Debug",
      "problemMatcher": []
    }
  ]
}
