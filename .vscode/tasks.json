{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SliceSoft: Configure Main Build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "slicesoft-main"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "detail": "配置 Visual Studio x64 多配置主构建目录；已有 cache 时通常只需约 1-2 秒。"
    },
    {
      "label": "SliceSoft: Fast Build (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "slicesoft-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Configure Main Build",
      "group": "build",
      "problemMatcher": "$msCompile",
      "detail": "仅执行 Debug 增量编译，不复制资源、不运行 windeployqt。"
    },
    {
      "label": "SliceSoft: Deploy Runtime (Debug, No Build)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/PrepareSliceSoftRuntime.ps1",
        "-BuildDir",
        "build-slicesoft/main",
        "-RuntimeDir",
        "runtime/slicesoft",
        "-Config",
        "Debug",
        "-BuildSystem",
        "VisualStudio",
        "-DeployOnly"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "detail": "仅重新部署现有 Debug 产物和资源，不进行编译。"
    },
    {
      "label": "SliceSoft: Build Runtime (Debug)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "SliceSoft: Fast Build (Debug)",
        "SliceSoft: Deploy Runtime (Debug, No Build)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "先执行 Debug 快速增量编译，再部署完整 Debug Runtime。"
    },
    {
      "label": "SliceSoft: Run UI (Debug)",
      "type": "shell",
      "command": "${workspaceFolder}/runtime/slicesoft/Debug/slicer_debug_ui.exe",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Runtime (Debug)",
      "problemMatcher": [],
      "detail": "编译完成后直接运行 Debug UI，不附加调试器。"
    },
    {
      "label": "SliceSoft: Fast Build (Release)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "slicesoft-release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Configure Main Build",
      "group": "build",
      "problemMatcher": "$msCompile",
      "detail": "仅执行 Release 增量编译，不复制资源、不运行 windeployqt。"
    },
    {
      "label": "SliceSoft: Build Runtime (Release)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "SliceSoft: Fast Build (Release)",
        "SliceSoft: Deploy Runtime (Release, No Build)"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": "先执行 Release 快速增量编译，再部署完整 Release Runtime。"
    },
    {
      "label": "SliceSoft: Run UI (Release)",
      "type": "shell",
      "command": "${workspaceFolder}/runtime/slicesoft/Release/slicer_debug_ui.exe",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Runtime (Release)",
      "problemMatcher": [],
      "detail": "编译完成后直接运行 Release UI。"
    },
    {
      "label": "SliceSoft: Quick Run UI (Debug, No Build)",
      "type": "shell",
      "command": "${workspaceFolder}/runtime/slicesoft/Debug/slicer_debug_ui.exe",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "直接运行已部署的 Debug UI，不触发编译或部署。"
    },
    {
      "label": "SliceSoft: Quick Run UI (Release, No Build)",
      "type": "shell",
      "command": "${workspaceFolder}/runtime/slicesoft/Release/slicer_debug_ui.exe",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "直接运行已部署的 Release UI，不触发编译或部署。"
    },
    {
      "label": "SliceSoft: Deploy Runtime (Release, No Build)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/PrepareSliceSoftRuntime.ps1",
        "-BuildDir",
        "build-slicesoft/main",
        "-RuntimeDir",
        "runtime/slicesoft",
        "-Config",
        "Release",
        "-BuildSystem",
        "VisualStudio",
        "-DeployOnly"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "detail": "仅重新部署现有 Release 产物和资源，不进行编译。"
    },
    {
      "label": "SliceSoft: Build All Runtimes",
      "dependsOrder": "sequence",
      "dependsOn": [
        "SliceSoft: Build Runtime (Debug)",
        "SliceSoft: Build Runtime (Release)"
      ],
      "problemMatcher": [],
      "detail": "依次构建 Debug 和 Release 两套 Runtime。"
    },
    {
      "label": "SliceSoft: Test Runtime (Debug)",
      "type": "shell",
      "command": "${workspaceFolder}/runtime/slicesoft/Debug/slicer_debug_ui.exe",
      "args": [
        "--self-test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Runtime (Debug)",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Test Runtime (Release)",
      "type": "shell",
      "command": "${workspaceFolder}/runtime/slicesoft/Release/slicer_debug_ui.exe",
      "args": [
        "--self-test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Runtime (Release)",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft 14E: Build Packaged Host UI (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "slicesoft-debug",
        "--target",
        "slicer_ui_host_sim"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Configure Main Build",
      "group": "build",
      "problemMatcher": "$msCompile",
      "detail": "仅构建 Stage 14E 封装宿主 UI、slicer_module.dll 与 slicer_worker.exe；不替代原 slicer_debug_ui 入口。"
    },
    {
      "label": "SliceSoft 14E: Build Packaged Host UI (Release)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "slicesoft-release",
        "--target",
        "slicer_ui_host_sim"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Configure Main Build",
      "group": "build",
      "problemMatcher": "$msCompile",
      "detail": "仅构建 Stage 14E Release 封装宿主 UI 及其能力包依赖；不部署原 Runtime。"
    },
    {
      "label": "SliceSoft 14E: Run Packaged Host UI (Debug)",
      "type": "shell",
      "command": "${workspaceFolder}/build-slicesoft/main/apps/slicer_ui_host_sim/Debug/slicer_ui_host_sim.exe",
      "args": [
        "--module",
        "${workspaceFolder}/build-slicesoft/main/Debug/slicer_module.dll"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:QTDIR}/bin;${env:PATH}"
        }
      },
      "dependsOn": "SliceSoft 14E: Build Packaged Host UI (Debug)",
      "problemMatcher": [],
      "detail": "运行 Stage 14E Debug 封装宿主 UI，并显式加载 Debug slicer_module.dll。"
    },
    {
      "label": "SliceSoft 14E: Run Packaged Host UI (Release)",
      "type": "shell",
      "command": "${workspaceFolder}/build-slicesoft/main/apps/slicer_ui_host_sim/Release/slicer_ui_host_sim.exe",
      "args": [
        "--module",
        "${workspaceFolder}/build-slicesoft/main/Release/slicer_module.dll"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:QTDIR}/bin;${env:PATH}"
        }
      },
      "dependsOn": "SliceSoft 14E: Build Packaged Host UI (Release)",
      "problemMatcher": [],
      "detail": "运行 Stage 14E Release 封装宿主 UI，并显式加载 Release slicer_module.dll。"
    },
    {
      "label": "SliceSoft 14E: Self-Test Packaged Host UI (Debug)",
      "type": "shell",
      "command": "${workspaceFolder}/build-slicesoft/main/apps/slicer_ui_host_sim/Debug/slicer_ui_host_sim.exe",
      "args": [
        "--self-test",
        "--module",
        "${workspaceFolder}/build-slicesoft/main/Debug/slicer_module.dll"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:QTDIR}/bin;${env:PATH}",
          "QT_QPA_PLATFORM": "offscreen"
        }
      },
      "dependsOn": "SliceSoft 14E: Build Packaged Host UI (Debug)",
      "group": "test",
      "problemMatcher": [],
      "detail": "离屏验证 Stage 14E Debug 宿主可加载能力包并通过公共 SPI 自检。"
    },
    {
      "label": "SliceSoft 14E: Self-Test Packaged Host UI (Release)",
      "type": "shell",
      "command": "${workspaceFolder}/build-slicesoft/main/apps/slicer_ui_host_sim/Release/slicer_ui_host_sim.exe",
      "args": [
        "--self-test",
        "--module",
        "${workspaceFolder}/build-slicesoft/main/Release/slicer_module.dll"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:QTDIR}/bin;${env:PATH}",
          "QT_QPA_PLATFORM": "offscreen"
        }
      },
      "dependsOn": "SliceSoft 14E: Build Packaged Host UI (Release)",
      "group": "test",
      "problemMatcher": [],
      "detail": "离屏验证 Stage 14E Release 宿主可加载能力包并通过公共 SPI 自检。"
    },
    {
      "label": "SliceSoft 14F: Package Slicer Module (Release)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/PackageSlicerModule.ps1",
        "-Config",
        "Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "detail": "构建并打包 Stage 14F Release 能力包到 output/distribution/Release/modules/slicer；与原 Runtime 和 14E 宿主入口分离。"
    },
    {
      "label": "SliceSoft 14F: Validate Slicer Module Package (Release)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/TestSlicerModulePackage.ps1",
        "-Config",
        "Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft 14F: Package Slicer Module (Release)",
      "group": "test",
      "problemMatcher": [],
      "detail": "校验 14F 包结构、哈希、依赖闭包、Worker 合同，并通过纯 C 宿主执行导入到 RGBWSV 校验的本地闭环。"
    },
    {
      "label": "SliceSoft 14F: Prepare Print M1 Handoff (Release)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/Prepare14F02PrintM1Handoff.ps1",
        "-Config",
        "Release",
        "-SkipBuild"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft 14F: Validate Slicer Module Package (Release)",
      "group": "build",
      "problemMatcher": [],
      "detail": "生成 14F-02 打印侧 M1 联调交付目录，包含能力包、公开合同、独立探针、执行手册和全文件哈希。"
    },
    {
      "label": "SliceSoft 14F: Validate Print M1 Handoff (Release)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/Test14F02PrintM1Handoff.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft 14F: Prepare Print M1 Handoff (Release)",
      "group": "test",
      "problemMatcher": [],
      "detail": "验证 14F-02 交付哈希、SPI v1、15 项能力、运行时装载、自检和缺 DLL 负例；打印侧进程模块证据仍需外部回签。"
    },
    {
      "label": "SliceSoft 14F: Run Single Model S1 Gate (Release)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/Run14F03SingleModelS1Gate.ps1",
        "-BuildDirectory",
        "build-slicesoft/main",
        "-Config",
        "Release",
        "-RepositoryRoot",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft 14F: Validate Print M1 Handoff (Release)",
      "group": "test",
      "problemMatcher": [],
      "detail": "执行14F-03单模型导入、变换、Worker切片、S1严格正例和7类负例；打印侧M2实际联调保持延期。"
    },
    {
      "label": "SliceSoft 14F: Run S2 Contract Gate (Release)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/Run14F04S2ContractGate.ps1",
        "-RepositoryRoot",
        ".",
        "-OutputRoot",
        "build-slicesoft/main/stage14f04_evidence/Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft 14F: Run Single Model S1 Gate (Release)",
      "group": "test",
      "problemMatcher": [],
      "detail": "执行14F-04 S2 C1-C7本地合同正负例门禁；不声称目标RIP、ChannelSplitter或极性映射已经外部验收。"
    },
    {
      "label": "SliceSoft: Advanced - Build Runtime Release (NMake Fallback)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/PrepareSliceSoftRuntime.ps1",
        "-BuildDir",
        "build-slicesoft-nmake",
        "-RuntimeDir",
        "runtime/slicesoft",
        "-Config",
        "Release",
        "-BuildSystem",
        "NMake"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile",
      "detail": "仅在 Visual Studio/MSBuild 主轨道不可用时使用的 NMake Release 兜底入口。"
    },
    {
      "label": "SliceSoft: Advanced - Configure Legacy Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": "保留给 CTest、历史脚本和非 Runtime 回归的 build 目录。"
    },
    {
      "label": "SliceSoft: Advanced - Build Legacy Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--config",
        "Debug"
      ],
      "dependsOn": "SliceSoft: Advanced - Configure Legacy Debug",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "SliceSoft: Advanced - CTest Legacy Debug",
      "type": "shell",
      "command": "ctest",
      "args": [
        "--test-dir",
        "build",
        "-C",
        "Debug",
        "--output-on-failure"
      ],
      "dependsOn": "SliceSoft: Advanced - Build Legacy Debug",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Advanced - Run CLI Current Config",
      "type": "shell",
      "command": "${workspaceFolder}/runtime/slicesoft/Debug/slicer_cli.exe",
      "args": [
        "--config",
        "${input:sliceConfig}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Runtime (Debug)",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Advanced - Run RIP Reader",
      "type": "shell",
      "command": "${workspaceFolder}/runtime/slicesoft/Debug/rip_reader_test.exe",
      "args": [
        "--package",
        "${input:packageDir}",
        "--summary"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Runtime (Debug)",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Advanced - Build Worker Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build-slicesoft/main",
        "--config",
        "Debug",
        "--target",
        "slicer_worker",
        "--parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Configure Main Build",
      "group": "build",
      "problemMatcher": "$msCompile",
      "detail": "只构建 Stage 14D Worker，供独立请求调试入口使用。"
    },
    {
      "label": "SliceSoft: Stage 14D-08 Prepare Worker Debug Request",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/Prepare14D08WorkerDebugRequest.py",
        "--repo-root",
        "${workspaceFolder}",
        "--output",
        "${workspaceFolder}/output/debug/stage14d08_worker/request.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Advanced - Build Worker Debug",
      "problemMatcher": [],
      "detail": "生成绝对路径、身份闭合的 geometry.repair 调试请求。"
    },
    {
      "label": "SliceSoft: Advanced - Run Sample Matrix",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run_sample_matrix.ps1",
        "-SkipBuild"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Advanced - Build Legacy Debug",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Advanced - Run Quick Regression",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run_regression.ps1",
        "-Mode",
        "quick",
        "-SkipBuild"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Advanced - Build Legacy Debug",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Advanced - Clean Build",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/clean_local_environment.ps1",
        "-Build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Advanced - Clean Output",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/clean_local_environment.ps1",
        "-Output"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Advanced - Clean Build And Output",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/clean_local_environment.ps1",
        "-All"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "sliceConfig",
      "type": "promptString",
      "description": "切片配置 JSON 路径",
      "default": "samples/configs/material_process/nail_rgb_white_varnish_top2.json"
    },
    {
      "id": "packageDir",
      "type": "promptString",
      "description": "RGBWSV 输出包目录",
      "default": "output/NailRgbWhiteVarnishTop2"
    }
  ]
}
