{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SliceSoft: Configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Build Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--config",
        "Debug"
      ],
      "dependsOn": "SliceSoft: Configure",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "SliceSoft: Build Debug UI",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--config",
        "Debug",
        "--target",
        "slicer_debug_ui"
      ],
      "dependsOn": "SliceSoft: Configure",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "SliceSoft: CTest Debug",
      "type": "shell",
      "command": "ctest",
      "args": [
        "--test-dir",
        "build",
        "-C",
        "Debug",
        "--output-on-failure"
      ],
      "dependsOn": "SliceSoft: Build Debug",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Run slicer_cli current config",
      "type": "shell",
      "command": "${workspaceFolder}/build/Debug/slicer_cli.exe",
      "args": [
        "--config",
        "${input:sliceConfig}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Debug",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Run rip_reader current package",
      "type": "shell",
      "command": "${workspaceFolder}/build/Debug/rip_reader_test.exe",
      "args": [
        "--package",
        "${input:packageDir}",
        "--summary"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Debug",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Run sample matrix",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run_sample_matrix.ps1",
        "-SkipBuild"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Debug",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Run quick regression",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run_regression.ps1",
        "-Mode",
        "quick",
        "-SkipBuild"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Debug",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Run UI self-test",
      "type": "shell",
      "command": "${workspaceFolder}/build/apps/slicer_debug_ui/Debug/slicer_debug_ui.exe",
      "args": [
        "--self-test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Debug UI",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Clean build directory",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/clean_local_environment.ps1",
        "-Build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Clean output directory",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/clean_local_environment.ps1",
        "-Output"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Clean build and output",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/clean_local_environment.ps1",
        "-All"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "sliceConfig",
      "type": "promptString",
      "description": "切片配置 JSON 路径",
      "default": "samples/configs/material_process/nail_rgb_white_varnish_top2.json"
    },
    {
      "id": "packageDir",
      "type": "promptString",
      "description": "RGBWSV 输出包目录",
      "default": "output/NailRgbWhiteVarnishTop2"
    }
  ]
}
