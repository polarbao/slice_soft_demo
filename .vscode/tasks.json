{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SliceSoft: Build Runtime (Debug)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/PrepareSliceSoftRuntime.ps1",
        "-BuildDir",
        "build-slicesoft",
        "-RuntimeDir",
        "runtime/slicesoft",
        "-Config",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "detail": "构建并部署 Debug 版 UI、CLI、RIP Reader 和 Qt 运行依赖。"
    },
    {
      "label": "SliceSoft: Run UI (Debug)",
      "type": "shell",
      "command": "${workspaceFolder}/runtime/slicesoft/Debug/slicer_debug_ui.exe",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Runtime (Debug)",
      "problemMatcher": [],
      "detail": "编译完成后直接运行 Debug UI，不附加调试器。"
    },
    {
      "label": "SliceSoft: Build Runtime (Release)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/PrepareSliceSoftRuntime.ps1",
        "-BuildDir",
        "build-slicesoft",
        "-RuntimeDir",
        "runtime/slicesoft",
        "-Config",
        "Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile",
      "detail": "构建并部署用于实际性能观察的 Release Runtime。"
    },
    {
      "label": "SliceSoft: Run UI (Release)",
      "type": "shell",
      "command": "${workspaceFolder}/runtime/slicesoft/Release/slicer_debug_ui.exe",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Runtime (Release)",
      "problemMatcher": [],
      "detail": "编译完成后直接运行 Release UI。"
    },
    {
      "label": "SliceSoft: Build All Runtimes",
      "dependsOrder": "sequence",
      "dependsOn": [
        "SliceSoft: Build Runtime (Debug)",
        "SliceSoft: Build Runtime (Release)"
      ],
      "problemMatcher": [],
      "detail": "依次构建 Debug 和 Release 两套 Runtime。"
    },
    {
      "label": "SliceSoft: Test Runtime (Debug)",
      "type": "shell",
      "command": "${workspaceFolder}/runtime/slicesoft/Debug/slicer_debug_ui.exe",
      "args": [
        "--self-test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Runtime (Debug)",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Test Runtime (Release)",
      "type": "shell",
      "command": "${workspaceFolder}/runtime/slicesoft/Release/slicer_debug_ui.exe",
      "args": [
        "--self-test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Runtime (Release)",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Advanced - Configure Legacy Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": "保留给 CTest、历史脚本和非 Runtime 回归的 build 目录。"
    },
    {
      "label": "SliceSoft: Advanced - Build Legacy Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--config",
        "Debug"
      ],
      "dependsOn": "SliceSoft: Advanced - Configure Legacy Debug",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "SliceSoft: Advanced - CTest Legacy Debug",
      "type": "shell",
      "command": "ctest",
      "args": [
        "--test-dir",
        "build",
        "-C",
        "Debug",
        "--output-on-failure"
      ],
      "dependsOn": "SliceSoft: Advanced - Build Legacy Debug",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Advanced - Run CLI Current Config",
      "type": "shell",
      "command": "${workspaceFolder}/runtime/slicesoft/Debug/slicer_cli.exe",
      "args": [
        "--config",
        "${input:sliceConfig}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Runtime (Debug)",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Advanced - Run RIP Reader",
      "type": "shell",
      "command": "${workspaceFolder}/runtime/slicesoft/Debug/rip_reader_test.exe",
      "args": [
        "--package",
        "${input:packageDir}",
        "--summary"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Runtime (Debug)",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Advanced - Run Sample Matrix",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run_sample_matrix.ps1",
        "-SkipBuild"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Advanced - Build Legacy Debug",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Advanced - Run Quick Regression",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run_regression.ps1",
        "-Mode",
        "quick",
        "-SkipBuild"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Advanced - Build Legacy Debug",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Advanced - Clean Build",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/clean_local_environment.ps1",
        "-Build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Advanced - Clean Output",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/clean_local_environment.ps1",
        "-Output"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Advanced - Clean Build And Output",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/clean_local_environment.ps1",
        "-All"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "sliceConfig",
      "type": "promptString",
      "description": "切片配置 JSON 路径",
      "default": "samples/configs/material_process/nail_rgb_white_varnish_top2.json"
    },
    {
      "id": "packageDir",
      "type": "promptString",
      "description": "RGBWSV 输出包目录",
      "default": "output/NailRgbWhiteVarnishTop2"
    }
  ]
}
