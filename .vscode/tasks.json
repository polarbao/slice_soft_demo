{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SliceSoft: Configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Build Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--config",
        "Debug"
      ],
      "dependsOn": "SliceSoft: Configure",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "SliceSoft: Build Debug UI",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--config",
        "Debug",
        "--target",
        "slicer_debug_ui"
      ],
      "dependsOn": "SliceSoft: Configure",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "SliceSoft: Run slicer_cli sample",
      "type": "shell",
      "command": "${workspaceFolder}/build/Debug/slicer_cli.exe",
      "args": [
        "--config",
        "samples/configs/slice_config.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "SliceSoft: Build Debug",
      "problemMatcher": []
    },
    {
      "label": "SliceSoft: Run rip_reader_test sample",
      "type": "shell",
      "command": "${workspaceFolder}/build/Debug/rip_reader_test.exe",
