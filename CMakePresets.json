{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "slicesoft-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build-slicesoft/main",
      "cacheVariables": {
        "BUILD_SLICER_DEBUG_UI": "OFF",
        "BUILD_SLICER_UI_HOST_SIM": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_PREFIX_PATH": "$env{QTDIR}",
        "meshoptimizer_DIR": "${sourceDir}/build-slicesoft/vcpkg_installed/x64-windows/share/meshoptimizer",
        "SLICESOFT_TIFF_BACKEND": "libtiff",
        "USE_OPENVDB": "OFF",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build-slicesoft/vcpkg_installed",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "slicesoft-main",
      "displayName": "SliceSoft 主构建（Debug + Release）",
      "description": "Visual Studio 多配置增量构建；OpenVDB 默认关闭。",
      "inherits": "slicesoft-base"
    },
    {
      "name": "slicesoft-nmake-release-fallback",
      "displayName": "SliceSoft Release（NMake 兜底）",
      "description": "仅在 Visual Studio/MSBuild 轨道不可用时手动选择。",
      "generator": "NMake Makefiles",
      "binaryDir": "${sourceDir}/build-slicesoft-nmake/Release",
      "cacheVariables": {
        "BUILD_SLICER_DEBUG_UI": "OFF",
        "BUILD_SLICER_UI_HOST_SIM": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_PREFIX_PATH": "$env{QTDIR}",
        "meshoptimizer_DIR": "${sourceDir}/build-slicesoft/vcpkg_installed/x64-windows/share/meshoptimizer",
        "SLICESOFT_TIFF_BACKEND": "libtiff",
        "USE_OPENVDB": "OFF",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build-slicesoft/vcpkg_installed",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "slicesoft-libtiff",
      "displayName": "SliceSoft 03D LibTIFF 依赖轨道",
      "description": "LibTIFF 4.7.1 Writer/Runtime 专项验证轨道；默认生产轨道同样使用 LibTIFF。",
      "inherits": "slicesoft-base",
      "binaryDir": "${sourceDir}/build-slicesoft/03d-libtiff",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "meshoptimizer_DIR": "${sourceDir}/build-slicesoft/03d-libtiff/vcpkg_installed/x64-windows/share/meshoptimizer",
        "SLICESOFT_TIFF_BACKEND": "libtiff",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build-slicesoft/03d-libtiff/vcpkg_installed",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "slicesoft-handwritten-legacy",
      "displayName": "SliceSoft Handwritten 遗留验证轨道",
      "description": "仅用于 T-A-05 弃用观察期和字节对照，不是默认生产轨道。",
      "inherits": "slicesoft-base",
      "binaryDir": "${sourceDir}/build-slicesoft/03d-handwritten",
      "cacheVariables": {
        "meshoptimizer_DIR": "${sourceDir}/build-slicesoft/03d-handwritten/vcpkg_installed/x64-windows-static-md/share/meshoptimizer",
        "SLICESOFT_TIFF_BACKEND": "handwritten",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build-slicesoft/03d-handwritten/vcpkg_installed",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "slicesoft-debug",
      "displayName": "SliceSoft Debug 增量构建",
      "configurePreset": "slicesoft-main",
      "configuration": "Debug",
      "targets": [
        "slicesoft_runtime"
      ],
      "jobs": 16
    },
    {
      "name": "slicesoft-release",
      "displayName": "SliceSoft Release 增量构建",
      "configurePreset": "slicesoft-main",
      "configuration": "Release",
      "targets": [
        "slicesoft_runtime"
      ],
      "jobs": 16
    },
    {
      "name": "slicesoft-relwithdebinfo",
      "displayName": "SliceSoft RelWithDebInfo 增量构建",
      "configurePreset": "slicesoft-main",
      "configuration": "RelWithDebInfo",
      "targets": [
        "slicesoft_runtime"
      ],
      "jobs": 16
    },
    {
      "name": "slicesoft-nmake-release-fallback",
      "displayName": "SliceSoft Release（NMake 兜底）",
      "configurePreset": "slicesoft-nmake-release-fallback",
      "targets": [
        "slicesoft_runtime"
      ]
    },
    {
      "name": "slicesoft-libtiff-release",
      "displayName": "SliceSoft 03D LibTIFF Release",
      "configurePreset": "slicesoft-libtiff",
      "configuration": "Release",
      "targets": [
        "slicesoft_runtime",
        "tiff_backend_build_info_unit_tests"
      ],
      "jobs": 16
    },
    {
      "name": "slicesoft-handwritten-legacy-release",
      "displayName": "SliceSoft Handwritten 遗留 Release",
      "configurePreset": "slicesoft-handwritten-legacy",
      "configuration": "Release",
      "targets": [
        "tiff_writer_contract_unit_tests",
        "tiff_backend_build_info_unit_tests"
      ],
      "jobs": 16
    }
  ],
  "testPresets": [
    {
      "name": "slicesoft-debug-core",
      "displayName": "SliceSoft Debug 核心检测（纯逻辑，约十几秒）",
      "description": "改完想立刻看一眼时用。按【是否起进程】划分而非按耗时阈值：纯逻辑 144 项串行仅 43.1 秒、最慢 3.36 秒，且不起进程因而并行安全；被排除的 104 项起子进程或用 Qt offscreen，占全量 1754 秒中的 1711 秒（97.6%），且在并行下墙钟膨胀十几到二十几倍、会撞自己的内部期限而假失败。并行度 8：这一档没有进程竞争，可以吃满一些。 另排除 2 项【继承自合并基 d28b6451 的既有失败】（stage16c06_bounded_support_shape_unit_tests、scene_layer_adapters_unit_tests）：一个恒显红灯的「十秒看一眼」档会训练人忽略红灯，所以这一档做到「好就是绿」。那 2 项在 fast / full 两档里照常出现，债没被藏起来。它们修好之后应把这两条排除删掉。",
      "configurePreset": "slicesoft-main",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 8
      },
      "filter": {
        "exclude": {
          "name": "^monowrap_plate_transfer_vs_varnish_tests$|^hostflow_|^hostux_|^matvol_|^frame_|^stage16_|^stage14d|^stage14e|^stage14f|^slicer_stage14d|^slicer_stage14e|^textured_scene_|^ripflow_|^rip_|^test_spi|^stage16c06_bounded_support_shape_unit_tests$|^scene_layer_adapters_unit_tests$"
        }
      }
    },
    {
      "name": "slicesoft-debug-fast",
      "displayName": "SliceSoft Debug 快集（排除最慢 8 项）",
      "description": "提交前用。实测最慢 8 项占全量耗时 75%，排除后覆盖面几乎不变。并行度 4 而非构建侧的 16：ctest 有 21 项 RUN_SERIAL（独占运行、并行时相加），占全量 1754 秒中的 931 秒，j=4 已接近墙钟下界，再加大收益极小。带 --repeat until-pass:2 是因为本档含起进程的测试，-j4 下会偶发假失败（实测：单独重跑即通过）；真失败会重复出现，重试过的项 ctest 会标出来。",
      "configurePreset": "slicesoft-main",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4,
        "repeat": {
          "mode": "until-pass",
          "count": 2
        }
      },
      "filter": {
        "exclude": {
          "name": "^monowrap_plate_transfer_vs_varnish_tests$|^hostflow_hd02_real_asset_matrix$|^frame_production_tests$|^stage14d08_r2_slice_executor_tests$|^stage16_contact_leveling_diagnostic_tests$|^hostux_preset_after_import$|^matvol_production_wiring_tests$|^hostux_restored_preset_after_import$|^matvol_rgbwsvt_legacy_package_tests$"
        }
      }
    },
    {
      "name": "slicesoft-debug-full",
      "displayName": "SliceSoft Debug 全量",
      "description": "里程碑用：合入产品线，或改动触及被快集排除的 8 项所覆盖的域。并行度 4 而非构建侧的 16：ctest 有 21 项 RUN_SERIAL（独占运行、并行时相加），占全量 1754 秒中的 931 秒，j=4 已接近墙钟下界，再加大收益极小。带 --repeat until-pass:2 是因为本档含起进程的测试，-j4 下会偶发假失败（实测：单独重跑即通过）；真失败会重复出现，重试过的项 ctest 会标出来。",
      "configurePreset": "slicesoft-main",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4,
        "repeat": {
          "mode": "until-pass",
          "count": 2
        }
      }
    }
  ]
}
