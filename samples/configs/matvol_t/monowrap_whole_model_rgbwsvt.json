{
  "slicingMode": "relief_heightfield",
  "input": {
    "modelPath": "../../models/textured/fixtures/policy_textured_small.obj",
    "format": "auto"
  },
  "output": {
    "packageDir": "output/NailTransferOnly_rgbwsvt",
    "dpiX": 600,
    "dpiY": 600,
    "layerThicknessMm": 0.01,
    "channelOrder": [
      "R",
      "G",
      "B",
      "W",
      "S",
      "V",
      "T"
    ],
    "bitDepth": 8,
    "planarConfig": "contiguous",
    "storageMode": "stripped",
    "rowsPerStrip": 64,
    "packageProtocol": "p0.rgbwsvt.1"
  },
  "autoOrient": {
    "enabled": true,
    "maxHeightMm": 6.0,
    "strategy": "minimize_height_by_right_angle_rotation"
  },
  "background": {
    "value": 255
  },
  "modelMaterial": {
    "materialChannel": "RGB",
    "applyMode": "solid_volume",
    "rgb": [
      0,
      0,
      0
    ],
    "whiteValue": 255,
    "varnishValue": 255
  },
  "materialPolicy": {
    "enabled": true,
    "rgb": {
      "enabled": false,
      "source": "modelMaterial"
    },
    "white": {
      "enabled": false,
      "mode": "disabled",
      "value": 0,
      "layers": "all_model"
    },
    "varnish": {
      "enabled": false,
      "mode": "disabled",
      "value": 0,
      "topLayers": 1
    },
    "conflictPolicy": "model_material_over_support"
  },
  "materialProcessProfile": {
    "enabled": true,
    "name": "nail_varnish_only_rgbwsvt",
    "target": "uv_relief_nail",
    "rgb": {
      "enabled": false,
      "source": "modelMaterial"
    },
    "white": {
      "enabled": false,
      "mode": "disabled",
      "coverage": "all_model",
      "value": 0,
      "expandPx": 0,
      "shrinkPx": 0
    },
    "varnish": {
      "enabled": true,
      "mode": "all_model",
      "topLayers": 1,
      "value": 0,
      "coverage": "model_surface"
    },
    "support": {
      "expected": true,
      "mode": "existing_support_pipeline"
    },
    "validation": {
      "requireRgbPixels": false,
      "requireWhitePixels": false,
      "requireVarnishPixels": true,
      "requireSupportPixels": false,
      "maxUnexpectedOverlapPixels": 0
    }
  },
  "support": {
    "enabled": true,
    "mode": "bottom_projection",
    "value": 0,
    "offsetMm": 0.0,
    "minAreaPx": 0
  },
  "relief": {
    "fillMode": "intersection_range",
    "baseZMm": 0.0
  },
  "preview": {
    "enabled": false,
    "format": "png",
    "interval": 1,
    "channels": [
      "varnish",
      "support"
    ]
  },
  "transferChannelPolicy": {
    "enabled": true,
    "matchSource": "whole_model",
    "materialDiffuseRgbValues": [],
    "missingRegion": "allow_empty",
    "multipleMatches": "fail_closed",
    "value": 0,
    "topology": {
      "selfIntersectionPolicy": "tolerate_closed_self_intersection",
      "maxSelfIntersectionPairs": 64,
      "maxBoundaryEdges": 8
    }
  },
  "_comment": "单材料缩裹（MONOWRAP）。matchSource=whole_model 表示整个模型即缩裹材料，不做漫反射 RGB 匹配，故 materialDiffuseRgbValues 必须为空。供无 mtl 的纯几何资产使用（如 model/obj/alg_suoguo/ 下的缩裹件）。RGB/白墨/光油三通道全关，输出只有 T 有内容。topology 沿用模板的保守容限：maxSelfIntersectionPairs=64、maxBoundaryEdges=8——实测 alg_suoguo/20260908-HuangChenC 的 10 件里 5 件可直接通过，4 件自交 68~172 对超限、1 件非流形。抬容限属门禁放宽须先授权，超限件应先走 slicer_cli --repair-asset 修复。详见 docs/monowrap/。"
}
