        255,
        0
      ]
    ],
    "missingRegion": "allow_empty",
    "multipleMatches": "fail_closed",
    "value": 0,
    "topology": {
      "selfIntersectionPolicy": "tolerate_closed_self_intersection",
      "maxSelfIntersectionPairs": 64,
      "maxBoundaryEdges": 8
    }
