{
  "_comment": "MATVOL-T prototype only. Material RGB is profile data; material names are not role configuration.",
  "input": {
    "format": "obj",
    "modelPath": "../../../model/obj/reality/finger_suoguo/03.obj"
  },
  "output": {
    "packageDir": "../../../output/MatvolTransferPrototype",
    "packageProtocol": "p0.rgbwsvt.1",
