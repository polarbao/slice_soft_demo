{
  "slicePipeline": {
    "mode": "global_surface_shell"
  },
  "input": {
    "modelPath": "../../../model/obj/yecan/3.obj",
    "format": "obj"
  },
  "output": {
    "packageDir": "output/benchmarks/12e_08d_05_global_material_parity/yecan/package",
    "dpiX": 600,
