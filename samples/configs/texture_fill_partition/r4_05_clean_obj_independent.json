  "materialProcessProfile": {
    "enabled": true,
    "name": "r4_05_clean_positive_white",
    "target": "diagnostic_only",
    "rgb": {
      "enabled": true,
      "source": "texture_or_color"
    },
    "white": {
      "enabled": true,
      "mode": "underbase",
      "coverage": "all_model",
      "value": 0,
      "expandPx": 0,
      "shrinkPx": 0
    }
  }
