{
  "input": {
    "modelPath": "../../models/support/floating_island.stl",
    "format": "auto"
  },
  "output": {
    "packageDir": "output/SupportUnsupportedOnly",
    "dpiX": 600,
    "dpiY": 600,
    "layerThicknessMm": 0.05,
    "channelOrder": ["R", "G", "B", "W", "S", "V"],
    "bitDepth": 8,
    "planarConfig": "contiguous",
    "tiled": true,
    "tileSize": [256, 256]
  },
  "modelMaterial": {
    "materialChannel": "V",
    "applyMode": "solid_volume",
    "rgb": [255, 255, 255],
    "whiteValue": 255,
    "varnishValue": 0
  },
  "support": {
    "enabled": true,
    "mode": "unsupported_only",
    "value": 0,
    "minOverlapRatio": 0.2,
    "minIslandAreaPx": 16,
    "connectivity": 8,
    "unsupportedProjection": "project_to_build_plate"
  },
  "preview": {
    "enabled": true,
    "format": "png",
    "interval": 1,
    "channels": ["varnish", "support"],
    "onlyNonEmptyLayers": true
  }
}
