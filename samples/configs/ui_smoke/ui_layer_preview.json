{
  "slicingMode": "relief_heightfield",
  "input": {
    "modelPath": "samples/models/textured/fixtures/policy_textured_small.obj",
    "format": "auto"
  },
  "output": {
    "packageDir": "output/UiSmokeLayerPreview",
    "dpiX": 600,
    "dpiY": 600,
    "layerThicknessMm": 0.01,
    "channelOrder": ["R", "G", "B", "W", "S", "V"],
    "bitDepth": 8,
    "planarConfig": "contiguous",
    "storageMode": "stripped",
    "rowsPerStrip": 64
  },
  "autoOrient": {
    "enabled": true,
    "maxHeightMm": 6.0,
    "strategy": "minimize_height_by_right_angle_rotation"
  },
  "background": {
    "value": 255
  },
  "modelMaterial": {
    "materialChannel": "RGB",
    "applyMode": "solid_volume",
    "rgb": [0, 0, 0],
    "whiteValue": 255,
    "varnishValue": 255
  },
  "texture": {
    "enabled": true,
    "applyMode": "solid_volume_from_top_surface",
    "sampler": "bilinear",
    "uvAddressMode": "clamp",
    "flipV": true,
    "fallbackRgb": [0, 0, 0],
    "missingTexturePolicy": "warn_and_fallback"
  },
  "materialPolicy": {
    "enabled": true,
    "rgb": {
      "enabled": true,
      "source": "texture_or_fallback"
    },
    "white": {
      "enabled": true,
      "mode": "underbase",
      "value": 0,
      "layers": "all_model"
    },
    "varnish": {
      "enabled": true,
      "mode": "top_n_layers",
      "value": 0,
      "topLayers": 2
    },
    "conflictPolicy": "model_material_over_support"
  },
  "materialProcessProfile": {
    "enabled": true,
    "name": "ui_layer_preview",
    "target": "ui_smoke_layer_preview",
    "rgb": {
      "enabled": true,
      "source": "texture_or_color"
    },
    "white": {
      "enabled": true,
      "mode": "underbase",
      "coverage": "all_model",
      "value": 0,
      "expandPx": 0,
      "shrinkPx": 0
    },
    "varnish": {
      "enabled": true,
      "mode": "top_n_layers",
      "topLayers": 2,
      "value": 0,
      "coverage": "model_surface"
    },
    "support": {
      "expected": true,
      "mode": "existing_support_pipeline"
    },
    "validation": {
      "requireRgbPixels": true,
      "requireWhitePixels": true,
      "requireVarnishPixels": true,
      "requireSupportPixels": false,
      "maxUnexpectedOverlapPixels": 0
    }
  },
  "support": {
    "enabled": true,
    "mode": "bottom_projection",
    "value": 0,
    "offsetMm": 0.0,
    "minAreaPx": 0
  },
  "relief": {
    "fillMode": "intersection_range",
    "baseZMm": 0.0
  },
  "preview": {
    "enabled": true,
    "format": "png",
    "interval": 1,
    "channels": ["rgb", "white", "varnish", "support"],
    "onlyNonEmptyLayers": true,
    "pseudoColors": {
      "empty": [255, 255, 255],
      "support": [0, 255, 0],
      "white": [0, 170, 255],
      "varnish": [127, 127, 127]
    }
  }
}
