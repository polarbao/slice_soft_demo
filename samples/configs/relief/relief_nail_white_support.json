{
  "slicingMode": "relief_heightfield",
  "input": {
    "modelPath": "../../models/relief/relief_nail_arched.obj",
    "format": "auto"
  },
  "output": {
    "packageDir": "output/ReliefNailWhiteSupport",
    "dpiX": 635,
    "dpiY": 600,
    "layerThicknessMm": 0.038,
    "channelOrder": ["R", "G", "B", "W", "S", "V"],
    "bitDepth": 8,
    "planarConfig": "contiguous",
    "storageMode": "stripped",
    "rowsPerStrip": 64
  },
  "modelTransform": {
    "unit": "mm",
    "scale": [1.0, 1.0, 1.0],
    "rotationDeg": [0.0, 0.0, 0.0],
    "translationMm": [0.0, 0.0, 0.0]
  },
  "autoOrient": {
    "enabled": true,
    "maxHeightMm": 9.0,
    "strategy": "minimize_height_by_right_angle_rotation"
  },
  "background": {
    "value": 255
  },
  "modelMaterial": {
    "materialChannel": "W",
    "applyMode": "solid_volume",
    "rgb": [255, 255, 255],
    "whiteValue": 0,
    "varnishValue": 255
  },
  "materialProcessProfile": {
    "enabled": true,
    "name": "single_material_relief",
    "target": "single_material_relief",
    "rgb": {
      "enabled": false,
      "source": "modelMaterial"
    },
    "white": {
      "enabled": true,
      "mode": "all_model",
      "coverage": "all_model",
      "value": 0,
      "expandPx": 0,
      "shrinkPx": 0
    },
    "varnish": {
      "enabled": false,
      "mode": "disabled",
      "topLayers": 1,
      "value": 0,
      "coverage": "model_surface"
    },
    "support": {
      "expected": true,
      "mode": "existing_support_pipeline"
    },
    "validation": {
      "requireRgbPixels": false,
      "requireWhitePixels": true,
      "requireVarnishPixels": false,
      "requireSupportPixels": true,
      "maxUnexpectedOverlapPixels": 0
    }
  },
  "support": {
    "enabled": true,
    "mode": "bottom_projection",
    "value": 0,
    "offsetMm": 0.0,
    "minAreaPx": 0
  },
  "relief": {
    "fillMode": "intersection_range",
    "baseZMm": 0.0
  },
  "preview": {
    "enabled": true,
    "format": "png",
    "interval": 10,
    "channels": ["white", "support"],
    "onlyNonEmptyLayers": true
  }
}
