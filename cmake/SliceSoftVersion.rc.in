#include <winver.h>
#include "SliceSoftBuildVersion.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SLICESOFT_RC_VERSION_MAJOR@,@SLICESOFT_RC_VERSION_MINOR@,@SLICESOFT_RC_VERSION_PATCH@,0
 PRODUCTVERSION @SLICESOFT_RC_VERSION_MAJOR@,@SLICESOFT_RC_VERSION_MINOR@,@SLICESOFT_RC_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG | @SLICESOFT_RC_PRERELEASE_FLAG@
#else
 FILEFLAGS @SLICESOFT_RC_PRERELEASE_FLAG@
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @SLICESOFT_RC_FILE_TYPE@
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SliceSoft\0"
            VALUE "FileDescription", "@SLICESOFT_RC_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@SLICESOFT_RC_IMPLEMENTATION_VERSION@\0"
            VALUE "InternalName", "@SLICESOFT_RC_INTERNAL_NAME@\0"
            VALUE "OriginalFilename", "@SLICESOFT_RC_ORIGINAL_FILENAME@\0"
            VALUE "PrivateBuild", @SLICESOFT_RC_FULL_BUILD_VERSION_MACRO@ "\0"
            VALUE "ProductName", "@SLICESOFT_RC_PRODUCT_NAME@\0"
            VALUE "ProductVersion", "@SLICESOFT_RC_IMPLEMENTATION_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
